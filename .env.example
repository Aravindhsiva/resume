# LLM provider: openrouter (default), mock, or ollama
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional headers
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Dynamic Resume Generator

# App protection (recommended for public deployments)
# Use either Basic Auth for everything or a shared API token for /api/*
APP_BASIC_AUTH=
APP_API_TOKEN=

# Ollama (optional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
